type: GenericCrafter
name: Thermal Boiler
description: Produces steam using heat.

size: 3
health: 230

category: crafting
buildVisibility: shown
buildTime: 240

craftTime: 60

requirements: [
    ox-iron/100
    ox-copper/40
]

hasItems: true
itemCapacity: 10

hasLiquids: true
liquidCapacity: 100

consumes: {
    items: [
        ox-coal/1
    ]
}

outputLiquid: ox-steam/0.5

drawer: {
    type: DrawMulti
    drawers: [
        {
            type: DrawRegion
            suffix: -bottom
        }
        {
            type: DrawLiquidTile
            drawLiquid: ox-steam
            padLeft: -4
            padTop: 4
            padBottom: -4
            padRight: 4
        }
        {
            type: DrawDefault
        }
        {
            type: DrawWarmupRegion
        }
    ]
}